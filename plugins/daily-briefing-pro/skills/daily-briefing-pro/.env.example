# 每日简报生成器 — 环境变量配置
# 这些只是占位符；不要把填写后的文件提交到 Git 或插件包。

# AI 语义总结：API Key 与已登录 Codex CLI 二选一
# export DEEPSEEK_API_KEY="sk-xxxxxxxx"
# export DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
# export DEEPSEEK_MODEL="deepseek-chat"
# export DAILY_BRIEFING_CODEX_REASONING="low"
# export DAILY_BRIEFING_SEMANTIC_WORKERS="4"

# 可选 — 抖音云端转录服务（Key 留空时不启用该服务）
# export SILICONFLOW_API_KEY=""
# export GROQ_API_KEY=""
# export OPENAI_API_KEY=""

# 可选 — IMA知识库
# export IMA_OPENAPI_CLIENTID=""
# export IMA_OPENAPI_APIKEY=""

# 可选 — 同花顺官方金融数据 CLI（云端可使用环境变量，本地也可用 auth login）
# export HITHINK_FINANCE_API_KEY=""

# 可选 — 同花顺自选股路径
# export THS_SELFSTOCK_PATH="C:/应用/同花顺/mo_4aknfs5zs/SelfStockInfo.json"

# 平台登录态路径（只挂载到运行时，不放进插件目录）
# export TGB_COOKIE_PATH="./data/tgb_cookies.json"
# export DOUYIN_COOKIE_PATH="./data/douyin_cookies.json"
# export XUEQIU_COOKIE_PATH="./data/xueqiu_cookies.json"

# 行业轮动模型工作目录（必须可写：刷新 data/ 并写 outputs/）
# export ROTATION_MODEL_DIR="./models/sw_rotation_model"

# 持久数据和报告目录
# export DAILY_BRIEFING_DATA_DIR="./data-runtime"
# export BRIEFING_OUTPUT_DIR="./报告/每日简报"

# 可选 — 追加抖音博主（格式 name|url,name|url）
# export DOUYIN_BLOGGERS_EXTRA=""

# 可选 — 抖音并发转录数（默认串行）
# export DOUYIN_MAX_CONCURRENT="1"

# 抖音日报转录服务：默认本机；可显式改为 auto/groq/openai/siliconflow
# export DOUYIN_TRANSCRIPT_PROVIDER="local"
