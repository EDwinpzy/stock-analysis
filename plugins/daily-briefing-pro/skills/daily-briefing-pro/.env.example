# 每日简报生成器 — 环境变量配置
# 复制为 .env 或在终端中 source
# 注意：run_all.py 已内置讯飞 MaaS API 默认值，无需手动配置即可使用 AI 总结

# 必需 — 博主观点 AI 总结（已内置默认值，通常无需配置）
# 如需使用自己的 API Key，取消注释以下行即可覆盖默认值
# export DEEPSEEK_API_KEY="sk-xxxxxxxx"
# export DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
# export DEEPSEEK_MODEL="deepseek-chat"

# 可选 — 抖音转录加速
export SILICONFLOW_API_KEY="sk-xxxxxxxx"
export GROQ_API_KEY="gsk_xxxxxxxx"
export OPENAI_API_KEY="sk-xxxxxxxx"

# 可选 — IMA知识库
export IMA_OPENAPI_CLIENTID="xxxxxxxx"
export IMA_OPENAPI_APIKEY="xxxxxxxx"

# 可选 — 同花顺自选股路径
export THS_SELFSTOCK_PATH="C:/应用/同花顺/mo_4aknfs5zs/SelfStockInfo.json"

# 可选 — 淘股吧Cookie路径
export TGB_COOKIE_PATH="./data/tgb_cookies.json"

# 可选 — 追加抖音博主（格式 name|url,name|url）
export DOUYIN_BLOGGERS_EXTRA=""

# 可选 — 抖音并发转录数（默认 3）
export DOUYIN_MAX_CONCURRENT="3"
