{
  "schema_version": 1,
  "updated_at": "2026-11-12",
  "project": {
    "name": "股票分析 / Daily Briefing Pro",
    "repository": "EDwinpzy/stock-analysis",
    "local_env_file": "~/.codex/daily-briefing.env",
    "runtime_root": "~/.codex/daily-briefing-pro",
    "workflow": ".github/workflows/cloud-port-validation.yml",
    "template": "config/daily-briefing.env.example",
    "docs": "docs/credentials.md"
  },
  "items": [
    {
      "id": "fuyao_api_key",
      "label": "同花顺扶摇行情 API Key",
      "category": "行情",
      "kind": "env",
      "env": "FUYAO_API_KEY",
      "aliases": [
        "HITHINK_API_KEY",
        "HITHINK_FINANCE_API_KEY"
      ],
      "secret": true,
      "required": true,
      "github_secret": "FUYAO_API_KEY",
      "note": "行情查询、个股/行业报告的主行情凭据；兼容旧变量 HITHINK_API_KEY / HITHINK_FINANCE_API_KEY。"
    },
    {
      "id": "iwencai_api_key",
      "label": "问财 OpenAPI Key",
      "category": "行情",
      "kind": "env",
      "env": "IWENCAI_API_KEY",
      "aliases": [
        "WENCAI_API_KEY"
      ],
      "secret": true,
      "required": false,
      "github_secret": "IWENCAI_API_KEY",
      "note": "可选，与扶摇 Key 不通用；缺失或额度耗尽时使用东方财富、腾讯和同花顺补数，报告会标明降级来源。"
    },
    {
      "id": "daily_briefing_ai_base_url",
      "label": "AI Relay Base URL",
      "category": "AI",
      "kind": "env",
      "env": "DAILY_BRIEFING_AI_BASE_URL",
      "secret": false,
      "required": true,
      "github_secret": "DAILY_BRIEFING_AI_BASE_URL",
      "default": "https://magpie-relay.pengzhiyuan0724.workers.dev/v1",
      "note": "OpenAI Compatible 文本接口，不提供音频转录。"
    },
    {
      "id": "daily_briefing_ai_api_key",
      "label": "AI Relay Key",
      "category": "AI",
      "kind": "env",
      "env": "DAILY_BRIEFING_AI_API_KEY",
      "secret": true,
      "required": true,
      "github_secret": "DAILY_BRIEFING_AI_API_KEY",
      "note": "语义总结首选凭据；当前与 DEEPSEEK_API_KEY 使用同一个 relay Key。"
    },
    {
      "id": "daily_briefing_ai_model",
      "label": "AI Relay 主模型",
      "category": "AI",
      "kind": "env",
      "env": "DAILY_BRIEFING_AI_MODEL",
      "secret": false,
      "required": true,
      "github_secret": "DAILY_BRIEFING_AI_MODEL",
      "default": "workbuddy/deepseek-v4.1-flash"
    },
    {
      "id": "daily_briefing_ai_fallback_model",
      "label": "AI Relay 回退模型",
      "category": "AI",
      "kind": "env",
      "env": "DAILY_BRIEFING_AI_FALLBACK_MODEL",
      "secret": false,
      "required": false,
      "github_secret": "DAILY_BRIEFING_AI_FALLBACK_MODEL",
      "default": "group/free"
    },
    {
      "id": "deepseek_base_url",
      "label": "DeepSeek/Relay Base URL",
      "category": "AI",
      "kind": "env",
      "env": "DEEPSEEK_BASE_URL",
      "secret": false,
      "required": true,
      "github_secret": "DEEPSEEK_BASE_URL",
      "default": "https://magpie-relay.pengzhiyuan0724.workers.dev/v1",
      "note": "抖音文本总结和部分旧调用会读取这一组变量。"
    },
    {
      "id": "deepseek_api_key",
      "label": "DeepSeek/Relay Key",
      "category": "AI",
      "kind": "env",
      "env": "DEEPSEEK_API_KEY",
      "secret": true,
      "required": true,
      "github_secret": "DEEPSEEK_API_KEY",
      "note": "为兼容已有脚本，当前与 DAILY_BRIEFING_AI_API_KEY 保持一致。"
    },
    {
      "id": "deepseek_model",
      "label": "DeepSeek/Relay 主模型",
      "category": "AI",
      "kind": "env",
      "env": "DEEPSEEK_MODEL",
      "secret": false,
      "required": true,
      "github_secret": "DEEPSEEK_MODEL",
      "default": "workbuddy/deepseek-v4.1-flash"
    },
    {
      "id": "deepseek_fallback_model",
      "label": "DeepSeek/Relay 回退模型",
      "category": "AI",
      "kind": "env",
      "env": "DEEPSEEK_FALLBACK_MODEL",
      "secret": false,
      "required": false,
      "github_secret": "DEEPSEEK_FALLBACK_MODEL",
      "default": "group/free"
    },
    {
      "id": "tgb_cookie",
      "label": "淘股吧登录 Cookie",
      "category": "Cookie",
      "kind": "cookie_file",
      "env": "TGB_COOKIE_PATH",
      "default": "~/.codex/tgb_cookies.json",
      "required": true,
      "github_secret": "TGB_COOKIE_GZ_B64",
      "github_encoding": "gzip+base64",
      "login_markers": [
        "tgbpwd",
        "tgbuser"
      ],
      "login_required": true,
      "expiry_warn_hours": 72,
      "note": "登录态 Cookie 通常比行情 Key 短命；tgbpwd/tgbuser 任一过期都要重新导出。"
    },
    {
      "id": "douyin_cookie",
      "label": "抖音 Cookie",
      "category": "Cookie",
      "kind": "cookie_file",
      "env": "DOUYIN_COOKIE_PATH",
      "default": "~/.codex/daily-briefing-pro/data/douyin_cookies.json",
      "required": true,
      "github_secret": "DOUYIN_COOKIE_GZ_B64",
      "github_encoding": "gzip+base64",
      "login_markers": [
        "sessionid"
      ],
      "login_required": false,
      "expiry_warn_hours": 72,
      "note": "缺少 sessionid 时仍可尝试公开页采集，但不能称为登录态；需要稳定覆盖时补登录 Cookie。"
    },
    {
      "id": "xueqiu_cookie",
      "label": "雪球 Cookie",
      "category": "Cookie",
      "kind": "cookie_file",
      "env": "XUEQIU_COOKIE_PATH",
      "default": "~/.codex/daily-briefing-pro/data/xueqiu_cookies.json",
      "required": true,
      "github_secret": "XUEQIU_COOKIE_GZ_B64",
      "github_encoding": "gzip+base64",
      "login_markers": [
        "xq_a_token",
        "xq_is_login"
      ],
      "login_required": true,
      "expiry_warn_hours": 72,
      "note": "雪球 WAF 依赖浏览器上下文和登录 Cookie；只替换 xq_a_token 不一定足够。"
    },
    {
      "id": "douyin_transcript_provider",
      "label": "抖音转录通道",
      "category": "转录",
      "kind": "env",
      "env": "DOUYIN_TRANSCRIPT_PROVIDER",
      "secret": false,
      "required": false,
      "github_secret": null,
      "default": "local",
      "allowed": [
        "local",
        "auto",
        "cloud",
        "groq",
        "openai",
        "siliconflow"
      ],
      "note": "auto 会优先使用显式配置的通用 ASR，再尝试专用音频 API，最后回退到容器内置 Whisper；文本 Relay 不能作为音频接口。"
    },
    {
      "id": "douyin_asr_base_url",
      "label": "通用云端 ASR Base URL",
      "category": "转录",
      "kind": "env",
      "env": "DOUYIN_ASR_BASE_URL",
      "secret": false,
      "required": false,
      "github_secret": "DOUYIN_ASR_BASE_URL",
      "default": "",
      "note": "OpenAI Compatible 音频接口地址，例如 https://provider.example/v1；必须与 ASR Key、ASR 模型同时配置。"
    },
    {
      "id": "douyin_asr_api_key",
      "label": "通用云端 ASR Key",
      "category": "转录",
      "kind": "env",
      "env": "DOUYIN_ASR_API_KEY",
      "secret": true,
      "required": false,
      "github_secret": "DOUYIN_ASR_API_KEY",
      "note": "只用于支持 /audio/transcriptions 的 ASR 服务，不能填文本 AI Relay Key 来假装支持音频。"
    },
    {
      "id": "douyin_asr_model",
      "label": "通用云端 ASR 模型",
      "category": "转录",
      "kind": "env",
      "env": "DOUYIN_ASR_MODEL",
      "secret": false,
      "required": false,
      "github_secret": "DOUYIN_ASR_MODEL",
      "default": "",
      "note": "由 ASR 服务定义，例如 whisper-large-v3；三项 ASR 配置不完整时不会在 auto 模式中调用。"
    },
    {
      "id": "douyin_whisper_model",
      "label": "本地 Whisper 模型",
      "category": "转录",
      "kind": "env",
      "env": "DOUYIN_WHISPER_MODEL",
      "secret": false,
      "required": false,
      "github_secret": null,
      "default": "small",
      "note": "旧版 openai-whisper 与 faster-whisper 共用的模型名兜底；base 对财经口播的专有名词和数字错误率更高。"
    },
    {
      "id": "douyin_local_asr_engine",
      "label": "本地 ASR 引擎",
      "category": "转录",
      "kind": "env",
      "env": "DOUYIN_LOCAL_ASR_ENGINE",
      "secret": false,
      "required": false,
      "github_secret": null,
      "default": "auto",
      "allowed": [
        "auto",
        "faster-whisper",
        "whisper"
      ],
      "note": "auto 优先使用 faster-whisper/CTranslate2，未安装时回退旧 openai-whisper；云端固定 faster-whisper 以避免 torch。"
    },
    {
      "id": "douyin_faster_whisper_model",
      "label": "faster-whisper 模型",
      "category": "转录",
      "kind": "env",
      "env": "DOUYIN_FASTER_WHISPER_MODEL",
      "secret": false,
      "required": false,
      "github_secret": null,
      "default": "",
      "note": "留空时依次回退 DOUYIN_WHISPER_MODEL 和 small；模型在镜像构建时预下载。"
    },
    {
      "id": "douyin_faster_whisper_compute_type",
      "label": "faster-whisper 计算精度",
      "category": "转录",
      "kind": "env",
      "env": "DOUYIN_FASTER_WHISPER_COMPUTE_TYPE",
      "secret": false,
      "required": false,
      "github_secret": null,
      "default": "int8",
      "allowed": [
        "int8",
        "int8_float32",
        "float32"
      ],
      "note": "CPU 容器默认 int8；没有 GPU 时不要用 float16。"
    },
    {
      "id": "douyin_ai_base_url_legacy",
      "label": "旧抖音 AI Base URL",
      "category": "遗留",
      "kind": "env",
      "env": "DOUYIN_AI_BASE_URL",
      "secret": false,
      "required": false,
      "github_secret": null,
      "deprecated": true,
      "note": "代码未读取；实际抖音文本总结使用 DEEPSEEK_*。"
    },
    {
      "id": "douyin_ai_api_key_legacy",
      "label": "旧抖音 AI Key",
      "category": "遗留",
      "kind": "env",
      "env": "DOUYIN_AI_API_KEY",
      "secret": true,
      "required": false,
      "github_secret": null,
      "deprecated": true,
      "note": "代码未读取；不要在这里维护第二份 Key。"
    },
    {
      "id": "douyin_ai_model_legacy",
      "label": "旧抖音 AI 模型",
      "category": "遗留",
      "kind": "env",
      "env": "DOUYIN_AI_MODEL",
      "secret": false,
      "required": false,
      "github_secret": null,
      "deprecated": true,
      "note": "代码未读取；模型以 DEEPSEEK_MODEL 为准。"
    }
  ],
