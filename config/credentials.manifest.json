  "advanced": [
    {
      "env": "OPENAI_BASE_URL",
      "default": "https://api.openai.com/v1",
      "note": "OPENAI_* 兼容通道地址。"
    },
    {
      "env": "OPENAI_MODEL",
      "default": "gpt-4o-mini",
      "note": "OPENAI_* 兼容通道模型。"
    },
    {
      "env": "OPENAI_FALLBACK_MODEL",
      "default": "",
      "note": "OPENAI_* 兼容通道回退模型。"
    },
