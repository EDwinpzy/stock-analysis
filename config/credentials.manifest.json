{
  "schema_version": 1,
  "updated_at": "2026-11-13",
  "project": {
    "name": "股票分析 / Daily Briefing Pro",
    "repository": "EDwinpzy/stock-analysis",
    "local_env_file": "~/.codex/daily-briefing.env",
    "runtime_root": "~/.codex/daily-briefing-pro",
    "workflow": ".github/workflows/cloud-port-validation.yml",
    "template": "config/daily-briefing.env.example",
    "docs": "docs/credentials.md"
  },
  "items": [
    {
      "id": "fuyao_api_key",
      "label": "同花顺扶摇行情 API Key",
      "category": "行情",
      "kind": "env",
      "env": "FUYAO_API_KEY",
      "aliases": [
        "HITHINK_API_KEY",
        "HITHINK_FINANCE_API_KEY"
      ],
      "secret": true,
      "required": true,
      "github_secret": "FUYAO_API_KEY",
      "note": "行情查询、个股/行业报告的主行情凭据；兼容旧变量 HITHINK_API_KEY / HITHINK_FINANCE_API_KEY。"
    },
    {
      "id": "iwencai_api_key",
      "label": "问财 OpenAPI Key",
      "category": "行情",
      "kind": "env",
      "env": "IWENCAI_API_KEY",
      "aliases": [
        "WENCAI_API_KEY"
      ],
      "secret": true,
      "required": false,
      "github_secret": "IWENCAI_API_KEY",
      "note": "可选，与扶摇 Key 不通用；缺失或额度耗尽时使用东方财富、腾讯和同花顺补数，报告会标明降级来源。"
    },
    {
      "id": "daily_briefing_ai_base_url",
      "label": "AI Relay Base URL",
      "category": "AI",
      "kind": "env",
      "env": "DAILY_BRIEFING_AI_BASE_URL",
      "secret": false,
      "required": true,
      "github_secret": "DAILY_BRIEFING_AI_BASE_URL",
      "default": "https://magpie-relay.pengzhiyuan0724.workers.dev/v1",
      "note": "OpenAI Compatible 文本接口，不提供音频转录。"
    },
    {
      "id": "daily_briefing_ai_api_key",
      "label": "AI Relay Key",
      "category": "AI",
      "kind": "env",
      "env": "DAILY_BRIEFING_AI_API_KEY",
      "secret": true,
      "required": true,
      "github_secret": "DAILY_BRIEFING_AI_API_KEY",
      "note": "语义总结首选凭据；当前与 DEEPSEEK_API_KEY 使用同一个 relay Key。"
    },
    {
      "id": "daily_briefing_ai_model",
      "label": "AI Relay 主模型",
      "category": "AI",
      "kind": "env",
      "env": "DAILY_BRIEFING_AI_MODEL",
      "secret": false,
      "required": true,
      "github_secret": "DAILY_BRIEFING_AI_MODEL",
      "default": "workbuddy/deepseek-v4.1-flash"
    },
    {
      "id": "daily_briefing_ai_fallback_model",
      "label": "AI Relay 回退模型",
      "category": "AI",
      "kind": "env",
      "env": "DAILY_BRIEFING_AI_FALLBACK_MODEL",
      "secret": false,
      "required": false,
      "github_secret": "DAILY_BRIEFING_AI_FALLBACK_MODEL",
      "default": "group/free"
    },
    {
      "id": "deepseek_base_url",
      "label": "DeepSeek/Relay Base URL",
      "category": "AI",
      "kind": "env",
      "env": "DEEPSEEK_BASE_URL",
      "secret": false,
      "required": true,
      "github_secret": "DEEPSEEK_BASE_URL",
      "default": "https://magpie-relay.pengzhiyuan0724.workers.dev/v1",
      "note": "抖音文本总结和部分旧调用会读取这一组变量。"
    },
    {
      "id": "deepseek_api_key",
      "label": "DeepSeek/Relay Key",
      "category": "AI",
      "kind": "env",
      "env": "DEEPSEEK_API_KEY",
      "secret": true,
      "required": true,
      "github_secret": "DEEPSEEK_API_KEY",
      "note": "为兼容已有脚本，当前与 DAILY_BRIEFING_AI_API_KEY 保持一致。"
    },
    {
      "id": "deepseek_model",
      "label": "DeepSeek/Relay 主模型",
      "category": "AI",
      "kind": "env",
      "env": "DEEPSEEK_MODEL",
      "secret": false,
      "required": true,
      "github_secret": "DEEPSEEK_MODEL",
      "default": "workbuddy/deepseek-v4.1-flash"
    },
    {
      "id": "deepseek_fallback_model",
      "label": "DeepSeek/Relay 回退模型",
      "category": "AI",
      "kind": "env",
      "env": "DEEPSEEK_FALLBACK_MODEL",
      "secret": false,
      "required": false,
      "github_secret": "DEEPSEEK_FALLBACK_MODEL",
      "default": "group/free"
    },
    {
      "id": "tgb_cookie",
      "label": "淘股吧登录 Cookie",
      "category": "Cookie",
      "kind": "cookie_file",
      "env": "TGB_COOKIE_PATH",
      "default": "~/.codex/tgb_cookies.json",
      "required": true,
      "github_secret": "TGB_COOKIE_GZ_B64",
      "github_encoding": "gzip+base64",
      "login_markers": [
        "tgbpwd",
        "tgbuser"
      ],
      "login_required": true,
      "expiry_warn_hours": 72,
      "note": "登录态 Cookie 通常比行情 Key 短命；tgbpwd/tgbuser 任一过期都要重新导出。"
    },
    {
      "id": "douyin_cookie",
      "label": "抖音 Cookie",
      "category": "Cookie",
      "kind": "cookie_file",
      "env": "DOUYIN_COOKIE_PATH",
      "default": "~/.codex/daily-briefing-pro/data/douyin_cookies.json",
      "required": true,
      "github_secret": "DOUYIN_COOKIE_GZ_B64",
      "github_encoding": "gzip+base64",
      "login_markers": [
        "sessionid"
      ],
      "login_required": false,
      "expiry_warn_hours": 72,
      "note": "缺少 sessionid 时仍可尝试公开页采集，但不能称为登录态；需要稳定覆盖时补登录 Cookie。"
    },
    {
      "id": "xueqiu_cookie",
      "label": "雪球 Cookie",
      "category": "Cookie",
      "kind": "cookie_file",
      "env": "XUEQIU_COOKIE_PATH",
      "default": "~/.codex/daily-briefing-pro/data/xueqiu_cookies.json",
      "required": true,
      "github_secret": "XUEQIU_COOKIE_GZ_B64",
      "github_encoding": "gzip+base64",
      "login_markers": [
        "xq_a_token",
        "xq_is_login"
      ],
      "login_required": true,
      "expiry_warn_hours": 72,
      "note": "雪球 WAF 依赖浏览器上下文和登录 Cookie；只替换 xq_a_token 不一定足够。"
    },
    {
      "id": "douyin_resolver_base_url",
      "label": "抖音云端解析 API Base URL",
      "category": "抖音",
      "kind": "env",
      "env": "DOUYIN_RESOLVER_BASE_URL",
      "secret": false,
      "required": false,
      "github_secret": "DOUYIN_RESOLVER_BASE_URL",
      "default": "https://demo.douyin.wtf",
      "note": "dtk/Douyin-TikTok-API 兼容服务；用于在抖音网页不返回媒体地址时获取签名 CDN、标题和发布时间。留空且有 API Key 时默认 https://api.douyin.wtf。"
    },
    {
      "id": "douyin_resolver_api_key",
      "label": "抖音云端解析 API Key",
      "category": "抖音",
      "kind": "env",
      "env": "DOUYIN_RESOLVER_API_KEY",
      "secret": true,
      "required": false,
      "github_secret": "DOUYIN_RESOLVER_API_KEY",
      "note": "生产环境推荐配置；请求头 X-API-Key。未配置时可用公开 demo 账号做有限兜底，不保证额度和稳定性。"
    },
    {
      "id": "douyin_resolver_username",
      "label": "抖音云端解析用户名",
      "category": "抖音",
      "kind": "env",
      "env": "DOUYIN_RESOLVER_USERNAME",
      "secret": false,
      "required": false,
      "github_secret": "DOUYIN_RESOLVER_USERNAME",
      "note": "仅在解析服务使用用户名/密码登录时配置，与 PASSWORD 成对。"
    },
    {
      "id": "douyin_resolver_password",
      "label": "抖音云端解析密码",
      "category": "抖音",
      "kind": "env",
      "env": "DOUYIN_RESOLVER_PASSWORD",
      "secret": true,
      "required": false,
      "github_secret": "DOUYIN_RESOLVER_PASSWORD",
      "note": "仅在解析服务使用用户名/密码登录时配置，与 USERNAME 成对。"
    },
    {
      "id": "douyin_resolver_allow_demo",
      "label": "允许抖音解析匿名演示兜底",
      "category": "抖音",
      "kind": "env",
      "env": "DOUYIN_RESOLVER_ALLOW_DEMO",
      "secret": false,
      "required": false,
      "github_secret": null,
      "default": "1",
      "allowed": [
        "0",
        "1",
        "false",
        "true"
      ],
      "note": "生产环境建议在配置自有 API Key 后设为 0；匿名 demo 只用于有限兜底。"
    },
    {
      "id": "douyin_resolver_enabled",
      "label": "启用抖音云端解析 API",
      "category": "抖音",
      "kind": "env",
      "env": "DOUYIN_RESOLVER_ENABLED",
      "secret": false,
      "required": false,
      "github_secret": null,
      "default": "1",
      "allowed": [
        "0",
        "1",
        "false",
        "true"
      ],
      "note": "排障时可设为 0，回退到云容器内的 Playwright 页面解析；不读取用户电脑。"
    },
    {
      "id": "douyin_transcript_provider",
      "label": "抖音转录通道",
      "category": "转录",
      "kind": "env",
      "env": "DOUYIN_TRANSCRIPT_PROVIDER",
      "secret": false,
      "required": false,
      "github_secret": null,
      "default": "auto",
      "allowed": [
        "auto",
        "cloud",
        "groq",
        "openai",
        "siliconflow",
        "sttai",
        "notetakers"
      ],
      "note": "只走云端 API：auto 先用已配置的通用 ASR/Groq/OpenAI/SiliconFlow，再回退到无需 Key 的 STT.ai 与 NoteTakers；本地模型已移除，文本 Relay 不能作为音频接口。"
    },
    {
      "id": "douyin_asr_base_url",
      "label": "通用云端 ASR Base URL",
      "category": "转录",
      "kind": "env",
      "env": "DOUYIN_ASR_BASE_URL",
      "secret": false,
      "required": false,
      "github_secret": "DOUYIN_ASR_BASE_URL",
      "default": "",
      "note": "OpenAI Compatible 音频接口地址，例如 https://provider.example/v1；必须与 ASR Key、ASR 模型同时配置。"
    },
    {
      "id": "douyin_asr_api_key",
      "label": "通用云端 ASR Key",
      "category": "转录",
      "kind": "env",
      "env": "DOUYIN_ASR_API_KEY",
      "secret": true,
      "required": false,
      "github_secret": "DOUYIN_ASR_API_KEY",
      "note": "只用于支持 /audio/transcriptions 的 ASR 服务，不能填文本 AI Relay Key 来假装支持音频。"
    },
    {
      "id": "douyin_asr_model",
      "label": "通用云端 ASR 模型",
      "category": "转录",
      "kind": "env",
      "env": "DOUYIN_ASR_MODEL",
      "secret": false,
      "required": false,
      "github_secret": "DOUYIN_ASR_MODEL",
      "default": "",
      "note": "由 ASR 服务定义，例如 whisper-large-v3；三项 ASR 配置不完整时不会在 auto 模式中调用。"
    },
    {
      "id": "stt_ai_api_key",
      "label": "STT.ai API Key（可选）",
      "category": "转录",
      "kind": "env",
      "env": "STT_AI_API_KEY",
      "secret": true,
      "required": false,
      "github_secret": "STT_AI_API_KEY",
      "note": "可选。未配置时使用 STT.ai 匿名接口，每 IP 每日 3 次；配置后提高额度。"
    },
    {
      "id": "stt_ai_base_url",
      "label": "STT.ai Base URL（可选）",
      "category": "转录",
      "kind": "env",
      "env": "STT_AI_BASE_URL",
      "secret": false,
      "required": false,
      "github_secret": null,
      "default": "https://api.stt.ai",
      "note": "可覆盖 STT.ai 服务地址；默认 https://api.stt.ai。"
    },
    {
      "id": "stt_ai_model",
      "label": "STT.ai 模型（可选）",
      "category": "转录",
      "kind": "env",
      "env": "STT_AI_MODEL",
      "secret": false,
      "required": false,
      "github_secret": null,
      "default": "whisper-large-v3-turbo",
      "note": "STT.ai 文件转录模型，默认 whisper-large-v3-turbo。"
    },
    {
      "id": "stt_ai_language",
      "label": "STT.ai 语言（可选）",
      "category": "转录",
      "kind": "env",
      "env": "STT_AI_LANGUAGE",
      "secret": false,
      "required": false,
      "github_secret": null,
      "default": "zh",
      "note": "抖音财经口播默认按中文识别；可改为其他 ISO 语言码。"
    },
    {
      "id": "notetakers_asr_base_url",
      "label": "NoteTakers ASR Base URL（可选）",
      "category": "转录",
      "kind": "env",
      "env": "NOTETAKERS_ASR_BASE_URL",
      "secret": false,
      "required": false,
      "github_secret": null,
      "default": "https://notetakers.vipresearch.ca/stt/v1/transcribe",
      "note": "无 Key 云端 ASR 兜底地址；可替换为兼容的 NoteTakers 部署。"
    },
    {
      "id": "notetakers_asr_api_key",
      "label": "NoteTakers ASR Key（可选）",
      "category": "转录",
      "kind": "env",
      "env": "NOTETAKERS_ASR_API_KEY",
      "secret": true,
      "required": false,
      "github_secret": null,
      "note": "默认匿名接口无需 Key；仅在自建或需要鉴权的兼容端点时填写。"
    },
    {
      "id": "notetakers_asr_engine",
      "label": "NoteTakers ASR 引擎（可选）",
      "category": "转录",
      "kind": "env",
      "env": "NOTETAKERS_ASR_ENGINE",
      "secret": false,
      "required": false,
      "github_secret": null,
      "default": "whisper",
      "note": "默认 whisper。"
    },
    {
      "id": "notetakers_asr_language",
      "label": "NoteTakers ASR 语言（可选）",
      "category": "转录",
      "kind": "env",
      "env": "NOTETAKERS_ASR_LANGUAGE",
      "secret": false,
      "required": false,
      "github_secret": null,
      "default": "zh",
      "note": "抖音财经口播默认按中文识别。"
    },
    {
      "id": "douyin_cloud_asr_any",
      "label": "抖音云端 ASR（Key 可选，内置零 Key 兜底）",
      "category": "转录",
      "kind": "env_any_complete",
      "groups": [
        [
          "DOUYIN_ASR_BASE_URL",
          "DOUYIN_ASR_API_KEY",
          "DOUYIN_ASR_MODEL"
        ],
        [
          "GROQ_API_KEY"
        ],
        [
          "SILICONFLOW_API_KEY"
        ],
        [
          "OPENAI_API_KEY"
        ],
        [
          "STT_AI_API_KEY"
        ]
      ],
      "anonymous_available": true,
      "anonymous_label": "STT.ai + NoteTakers 匿名接口（合计约 13 次/日/IP）",
      "secret": true,
      "required": true,
      "github_secret": [
        "DOUYIN_ASR_BASE_URL",
        "DOUYIN_ASR_API_KEY",
        "DOUYIN_ASR_MODEL",
        "GROQ_API_KEY",
        "SILICONFLOW_API_KEY",
        "OPENAI_API_KEY",
        "STT_AI_API_KEY"
      ],
      "note": "抖音无字幕视频只走云端音频 API；未配置任何 Key 时依次使用 STT.ai（3 次/日/IP）与 NoteTakers（10 次/日/IP）。本地 Whisper 已移除，文本 Relay 不能作为音频接口。"
    },
    {
      "id": "groq_api_key",
      "label": "Groq Whisper API Key",
      "category": "转录",
      "kind": "env",
      "env": "GROQ_API_KEY",
      "secret": true,
      "required": false,
      "github_secret": "GROQ_API_KEY",
      "note": "云端 ASR 任选其一；Groq Whisper 免费额度，推荐。"
    },
    {
      "id": "siliconflow_api_key",
      "label": "SiliconFlow API Key",
      "category": "转录",
      "kind": "env",
      "env": "SILICONFLOW_API_KEY",
      "secret": true,
      "required": false,
      "github_secret": "SILICONFLOW_API_KEY",
