    },
    {
      "id": "openai_api_key",
      "label": "OpenAI API Key",
      "category": "转录",
      "kind": "env",
      "env": "OPENAI_API_KEY",
      "secret": true,
      "required": false,
      "github_secret": "OPENAI_API_KEY",
      "note": "云端 ASR 任选其一；OpenAI Whisper 为付费接口。"
    },
