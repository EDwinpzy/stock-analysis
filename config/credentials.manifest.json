    {
      "env": "THS_SELFSTOCK_CODES",
      "default": "",
      "note": "可选自选股代码清单，逗号/分号/空白分隔。云端优先使用此变量，不扫描本机同花顺目录。"
    },
    {
      "env": "THS_SELFSTOCK_JSON",
