# 运行环境凭证模板
#
# 使用方法：
#   1. 复制到 ~/.codex/daily-briefing.env
#   2. 填入真实值；Cookie 内容放在独立 JSON 文件中
#   3. 运行 python tools/credential_manifest.py check --github
#
# 这个文件只提交模板，不提交真实 Key、Cookie 或账号。

# ── 必填：行情 ───────────────────────────────────────────────────
FUYAO_API_KEY=

# ── 可选：问财 OpenAPI ───────────────────────────────────────────
# 缺失或额度耗尽时会使用东方财富、腾讯和同花顺补数，报告会标明降级来源。
IWENCAI_API_KEY=

# ── 必填：OpenAI Compatible 文本 AI Relay ────────────────────────
# 注意：文本 Relay 不支持 /audio/transcriptions，不能当作 ASR 接口。
DAILY_BRIEFING_AI_BASE_URL=https://magpie-relay.pengzhiyuan0724.workers.dev/v1
DAILY_BRIEFING_AI_API_KEY=
DAILY_BRIEFING_AI_MODEL=workbuddy/deepseek-v4.1-flash
DAILY_BRIEFING_AI_FALLBACK_MODEL=group/free

# 兼容已有抖音/旧脚本调用；当前与上面的 Relay Key 使用同一个值。
DEEPSEEK_BASE_URL=https://magpie-relay.pengzhiyuan0724.workers.dev/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=workbuddy/deepseek-v4.1-flash
DEEPSEEK_FALLBACK_MODEL=group/free

# ── 必填：Cookie 文件路径 ───────────────────────────────────────
# JSON 数组；淘股吧至少包含 tgbpwd + tgbuser，雪球至少包含 xq_a_token + xq_is_login。
TGB_COOKIE_PATH=~/.codex/tgb_cookies.json
DOUYIN_COOKIE_PATH=~/.codex/daily-briefing-pro/data/douyin_cookies.json
XUEQIU_COOKIE_PATH=~/.codex/daily-briefing-pro/data/xueqiu_cookies.json

# ── 转录策略：只走云端 ASR API，不使用本机模型 ─────────────────
# 抖音原生字幕优先；无字幕时必须至少配置下面任意一种音频 API。
DOUYIN_TRANSCRIPT_PROVIDER=auto

# ── 抖音媒体解析：云端数据 API（不依赖抖音网页媒体字段）────────
# 生产环境建议使用自己的 API Key。未填 Key 时可使用公开 demo 账号做有限兜底，
# 但额度和稳定性不受本项目控制；有 Key 且 Base URL 留空时默认
# https://api.douyin.wtf，无 Key 时默认 https://demo.douyin.wtf。
# DOUYIN_RESOLVER_BASE_URL=
# DOUYIN_RESOLVER_API_KEY=
# DOUYIN_RESOLVER_USERNAME=
# DOUYIN_RESOLVER_PASSWORD=
# DOUYIN_RESOLVER_ALLOW_DEMO=1
# DOUYIN_RESOLVER_ENABLED=1

# 方式 A：任意 OpenAI Compatible ASR（三项必须同时填写）。
# 不要把文本 AI Relay 地址填到这里，它不支持 /audio/transcriptions。
# DOUYIN_ASR_BASE_URL=
# DOUYIN_ASR_API_KEY=
# DOUYIN_ASR_MODEL=

# 方式 B：Groq / OpenAI / SiliconFlow 原生音频接口，任选其一即可。
# 推荐 Groq（免费额度）或 SiliconFlow SenseVoice（中文）。
# GROQ_API_KEY=
# OPENAI_API_KEY=
# SILICONFLOW_API_KEY=

# 方式 C：STT.ai。无需 Key 也可匿名调用，但额度约 3 次/日/IP；
# 配置 Key 可提高额度，适合多条视频的稳定无人值守日报。
STT_AI_API_KEY=
STT_AI_BASE_URL=https://api.stt.ai
STT_AI_MODEL=whisper-large-v3-turbo
STT_AI_LANGUAGE=zh

# ── 可选：固定同花顺账号（仅 thsdk 兼容通道）──────────────────
# THS_USERNAME=
# THS_PASSWORD=
# THS_MAC=

# ── 可选：自选股/板块清单（不扫描本机安装目录）────────────────
# 优先用代码清单；云端 Secret 可直接保存 JSON 字符串。
# THS_SELFSTOCK_CODES=600519,000001
# THS_SELFSTOCK_JSON={"stocks":[{"code":"600519","market":"17"}]}
# THS_SELFSTOCK_PATH=/run/secrets/ths_selfstock.json
# THS_STOCKBLOCK_PATH=

# ── 可选：自托管 Compose 的 IMA 预留项 ───────────────────────────
# 当前 Python 交付链路未读取；只有使用 Compose 的 IMA 集成时才填写。
# IMA_OPENAPI_CLIENTID=
# IMA_OPENAPI_APIKEY=

# ── 可选：路径覆盖 ─────────────────────────────────────────────
# DAILY_BRIEFING_HOME=~/.codex/daily-briefing-pro
# DAILY_BRIEFING_DATA_DIR=~/.codex/daily-briefing-pro/data
# BRIEFING_OUTPUT_DIR=~/.codex/daily-briefing-pro/reports
# STOCK_ANALYSIS_OUTPUT_DIR=
# INDUSTRY_ANALYSIS_OUTPUT_DIR=
# ROTATION_MODEL_DIR=
# DAILY_BRIEFING_MODEL_CACHE=
# XDG_CACHE_HOME=

# ── 可选：云端命令超时（秒）────────────────────────────────────
# DAILY_BRIEFING_PREFLIGHT_TIMEOUT=120
# DAILY_BRIEFING_COLLECT_TIMEOUT=300
# DAILY_BRIEFING_BUILD_TIMEOUT=120
# DAILY_BRIEFING_PROBE_TIMEOUT=300
# DAILY_BRIEFING_RUN_TIMEOUT=3600

# ── 可选：抖音采集/转录调优 ─────────────────────────────────────
# DOUYIN_MAX_CONCURRENT=1
# DOUYIN_MAX_STALE_DAYS=7
# DOUYIN_BLOGGERS_EXTRA=

# ── 可选：语义总结调优 ──────────────────────────────────────────
# DAILY_BRIEFING_SEMANTIC_WORKERS=4

# ── 可选：行情请求调优 ──────────────────────────────────────────
# DAILY_BRIEFING_WENCAI_TIMEOUT=25
# DAILY_BRIEFING_WENCAI_DELAY=0.35
# DAILY_BRIEFING_EASTMONEY_TIMEOUT=15
# BRIEFING_LIANBAN_SUPPLEMENT=1
# THS_MARKET_CLOUD_BASE_URL=https://fuyao.aicubes.cn
# WENCAI_QUERY_ENDPOINT=https://openapi.iwencai.com/v1/query2data

# ── 可选：代理 ─────────────────────────────────────────────────
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=
# https_proxy=
# HTTP_PROXY=
# http_proxy=
# NO_PROXY=
# no_proxy=

# ── 可选：仅自托管 Compose ──────────────────────────────────────
# DAILY_BRIEFING_IMAGE=daily-briefing-pro:3.23.19-cloud

# ── 不要使用（代码未读取的旧变量）─────────────────────────────
# DOUYIN_AI_BASE_URL=
# DOUYIN_AI_API_KEY=
# DOUYIN_AI_MODEL=
